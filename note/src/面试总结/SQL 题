-- 1.问 现有学生表和班级表,如何查询每个班级级中年龄最大的学生信息和班级名称(同一班级下没有同龄的学生)
SELECT name, age, class_name
FROM student
         LEFT JOIN class ON student.class_id = class.class_id
         INNER JOIN (SELECT class_id, MAX(age) AS max_age FROM student GROUP BY class_id) t
                    ON student.class_id = t.class_id AND student.age = t.max_age;