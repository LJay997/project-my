<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.qq.ijay997</groupId>
        <artifactId>project-my</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>jdk21</artifactId>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- MapStruct：1.6.3 是当前稳定版（1.7.x 仍为 Beta），完整支持 JDK 21 -->
        <org.mapstruct.version>1.6.3</org.mapstruct.version>
        <!-- Lombok：必须 1.18.30+ 才完整支持 JDK 21 -->
        <lombok.version>1.18.46</lombok.version>
        <lombok.mapstruct.binding.version>0.2.0</lombok.mapstruct.binding.version>
        <junit.jupiter.version>5.10.5</junit.jupiter.version>
        <spring.version>6.1.16</spring.version>
    </properties>

    <dependencies>
        <!-- MapStruct 核心注解（@Mapper / @Mapping 等） -->
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
            <version>${org.mapstruct.version}</version>
        </dependency>

        <!-- Lombok：提供传统实体的 getter/setter/builder -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- 仅用于演示 componentModel = "spring" 的 Mapper；provided 不影响打包 -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
            <version>${spring.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- JUnit 5 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.jupiter.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- 保留模块原有的 JUnit 4 依赖 -->
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.13.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>21</release>
                    <!-- 保留参数名：MapStruct 多源参数映射（@Mapping(source="paramName.field")）依赖它 -->
                    <parameters>true</parameters>
                    <!--
                        关闭增量编译：注解处理器（Lombok/MapStruct）多轮生成源码时，
                        3.13.0 的增量清理与 surefire fork JVM 扫描存在偶发时序竞态，
                        表现为运行时 NoClassDefFoundError。全量编译稳定且本模块规模很小。
                    -->
                    <useIncrementalCompilation>false</useIncrementalCompilation>
                    <annotationProcessorPaths>
                        <!-- 顺序很重要：Lombok 先生成 getter/setter，binding 协调，MapStruct 最后读取 -->
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok-mapstruct-binding</artifactId>
                            <version>${lombok.mapstruct.binding.version}</version>
                        </path>
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>${org.mapstruct.version}</version>
                        </path>
                    </annotationProcessorPaths>
                    <!--
                        其他常用 -A 参数（按需开启）：
                        -Amapstruct.unmappedTargetPolicy=WARN / ERROR
                        -Amapstruct.defaultComponentModel=spring
                        -Amapstruct.suppressGeneratorTimestamp=true
                        -Amapstruct.verbose=true
                        本示例的策略已直接声明在 @Mapper / @MapperConfig 注解上，更直观、优先级更高。
                    -->
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
        </plugins>
    </build>

</project>
